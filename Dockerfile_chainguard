# Spesifiser image SHA for alltid å kunne få dependabot til å si ifra om ny versjon. (For apper som ikke deployes ofte)
FROM europe-north1-docker.pkg.dev/cgr-nav/pull-through/nav.no/jre:openjdk-25@sha256:7458b9c7269026baa72266d5aa4a719031888cd6df96a8cde353324ba38dd664
ARG JAR_PATH

ENV LC_ALL='nb_NO.UTF-8' LANG='nb_NO.UTF-8' TZ='Europe/Oslo'

USER nonroot
WORKDIR /app

COPY ${JAR_PATH} app.jar

CMD ["-jar", "app.jar"]