# Spesifiser image SHA for alltid å kunne få dependabot til å si ifra om ny versjon. (For apper som ikke deployes ofte)
FROM europe-north1-docker.pkg.dev/cgr-nav/pull-through/nav.no/jre:openjdk-26@sha256:e97e2bff3ac840e4c19ffc075adfc2796d5b47688cc34593a3a86615f35a3242
ARG JAR_PATH

ENV LC_ALL='nb_NO.UTF-8' LANG='nb_NO.UTF-8' TZ='Europe/Oslo'

USER nonroot
WORKDIR /app

COPY ${JAR_PATH} app.jar

CMD ["-jar", "app.jar"]