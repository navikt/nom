{
  "name": "nom-ui",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev-debug": "vite --debug",
    "build": "tsc && vite build",
    "check-types": "tsc --noemit",
    "cy:open": "cypress open",
    "cy:run": "cypress run --spec './cypress/e2e/*'",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "stylelint": "stylelint '**/*.{tsx,css}'",
    "stylelint:fix": "stylelint --fix '**/*.{tsx,css}'",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx .",
    "generate-types": "swagger-typescript-api generate --path https://nom-api.intern.dev.nav.no/v3/api-docs/internal --output ./src/types --no-client -r -n api-models",
    "all-checks": "npm run check-types && npm run cy:run && npm run test && npm run lint && npm run stylelint",
    "all-checks-no-cypress": "npm run check-types && npm run test && npm run lint && npm run stylelint"
  },
  "dependencies": {
    "@apollo/client": "3.13.8",
    "@emotion/react": "11.14.0",
    "@grafana/faro-web-sdk": "1.19.0",
    "@grafana/faro-web-tracing": "1.19.0",
    "@hookform/resolvers": "5.1.1",
    "@navikt/aksel-icons": "7.25.1",
    "@navikt/ds-css": "7.25.1",
    "@navikt/ds-react": "7.25.1",
    "@tanstack/react-query": "5.83.0",
    "@tanstack/react-router": "1.129.8",
    "axios": "1.11.0",
    "date-fns": "4.1.0",
    "lodash": "4.17.21",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.61.0",
    "react-hot-toast": "2.5.2",
    "react-json-view-lite": "2.4.1",
    "react-select": "5.10.2",
    "yup": "1.6.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "5.0.7",
    "@graphql-codegen/introspection": "4.0.3",
    "@graphql-codegen/typescript": "4.1.6",
    "@graphql-codegen/typescript-operations": "4.6.1",
    "@graphql-codegen/typescript-react-apollo": "4.3.3",
    "@graphql-codegen/typescript-resolvers": "4.5.1",
    "@navikt/aksel-stylelint": "7.25.1",
    "@tanstack/react-query-devtools": "5.83.0",
    "@tanstack/router-devtools": "1.129.8",
    "@tanstack/router-vite-plugin": "1.129.8",
    "@types/lodash": "4.17.20",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@typescript-eslint/eslint-plugin": "8.38.0",
    "@typescript-eslint/parser": "8.38.0",
    "@vitejs/plugin-react": "4.7.0",
    "cypress": "14.5.2",
    "eslint": "9.31.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-lodash": "8.0.0",
    "eslint-plugin-prettier": "5.5.3",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unicorn": "59.0.1",
    "graphql": "16.11.0",
    "postcss-styled-syntax": "0.7.1",
    "prettier": "3.6.2",
    "stylelint": "16.22.0",
    "stylelint-config-standard": "38.0.0",
    "swagger-typescript-api": "13.2.7",
    "typescript": "5.8.3",
    "vite": "^7.0.6",
    "vitest": "3.2.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.45.1"
  }
}
