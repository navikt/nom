{
  "name": "nom-ui",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev-debug": "vite --debug",
    "build": "tsc && vite build",
    "check-types": "tsc --noemit",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "stylelint": "stylelint '**/*.{tsx,css}'",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx .",
    "stylelint:fix": "stylelint --fix '**/*.{tsx,css}'",
    "fixes": "npm run lint:fix && npm run stylelint:fix",
    "generate-types": "swagger-typescript-api generate --path https://nom-api.intern.dev.nav.no/v3/api-docs/internal --output ./src/types --no-client -r -n api-models",
    "all-checks": "npm run check-types && npm run test && npm run lint && npm run stylelint"
  },
  "dependencies": {
    "@apollo/client": "4.3.7",
    "@emotion/react": "11.14.0",
    "@grafana/faro-web-sdk": "2.13.0",
    "@grafana/faro-web-tracing": "2.13.0",
    "@hookform/resolvers": "7.0.3",
    "@navikt/aksel-icons": "8.22.1",
    "@navikt/ds-css": "8.22.1",
    "@navikt/ds-react": "8.22.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "axios": "1.21.0",
    "date-fns": "4.4.0",
    "lodash": "4.18.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-hot-toast": "2.6.1",
    "react-json-view-lite": "2.5.0",
    "react-select": "5.10.2",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/introspection": "7.0.0",
    "@graphql-codegen/typescript": "7.0.0",
    "@graphql-codegen/typescript-operations": "7.0.0",
    "@graphql-codegen/typescript-resolvers": "7.0.0",
    "@navikt/aksel-stylelint": "8.22.1",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/router-vite-plugin": "1.167.49",
    "@types/lodash": "4.17.27",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "4.18.0",
    "eslint-plugin-lodash": "8.1.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-jsx": "5.28.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unicorn": "74.0.0",
    "graphql": "17.1.0",
    "postcss-styled-syntax": "0.7.4",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "swagger-typescript-api": "13.13.0",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.68.0"
  }
}
