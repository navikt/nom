{
  "name": "nom-ui",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev-debug": "vite --debug",
    "build": "tsc && vite build",
    "check-types": "tsc --noemit",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "stylelint": "stylelint '**/*.{tsx,css}'",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx .",
    "stylelint:fix": "stylelint --fix '**/*.{tsx,css}'",
    "generate-types": "swagger-typescript-api generate --path https://nom-api.intern.dev.nav.no/v3/api-docs/internal --output ./src/types --no-client -r -n api-models",
    "all-checks": "npm run check-types && npm run test && npm run lint && npm run stylelint"
  },
  "dependencies": {
    "@apollo/client": "4.2.12",
    "@emotion/react": "11.14.0",
    "@grafana/faro-web-sdk": "2.11.0",
    "@grafana/faro-web-tracing": "2.11.0",
    "@hookform/resolvers": "5.9.1",
    "@navikt/aksel-icons": "7.38.0",
    "@navikt/ds-css": "7.38.0",
    "@navikt/ds-react": "7.38.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "axios": "1.20.0",
    "date-fns": "4.4.0",
    "lodash": "4.18.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-hot-toast": "2.6.0",
    "react-json-view-lite": "2.5.0",
    "react-select": "5.10.2",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.3.1",
    "@graphql-codegen/introspection": "6.1.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.6",
    "@graphql-codegen/typescript-resolvers": "6.1.0",
    "@navikt/aksel-stylelint": "7.38.0",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/router-vite-plugin": "1.167.35",
    "@types/lodash": "4.17.25",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-lodash": "8.0.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-jsx": "5.18.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unicorn": "74.0.0",
    "graphql": "17.0.2",
    "postcss-styled-syntax": "0.7.2",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "swagger-typescript-api": "13.12.6",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.63.1"
  }
}
