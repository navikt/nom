{
  "name": "nom-ui",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev-debug": "vite --debug",
    "build": "tsc && vite build",
    "check-types": "tsc --noemit",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "stylelint": "stylelint '**/*.{tsx,css}'",
    "stylelint:fix": "stylelint --fix '**/*.{tsx,css}'",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx .",
    "generate-types": "swagger-typescript-api generate --path https://nom-api.intern.dev.nav.no/v3/api-docs/internal --output ./src/types --no-client -r -n api-models",
    "all-checks": "npm run check-types && npm run test && npm run lint && npm run stylelint"
  },
  "dependencies": {
    "@apollo/client": "4.2.0",
    "@emotion/react": "11.14.0",
    "@grafana/faro-web-sdk": "2.7.0",
    "@grafana/faro-web-tracing": "2.7.0",
    "@hookform/resolvers": "5.4.0",
    "@navikt/aksel-icons": "7.38.0",
    "@navikt/ds-css": "7.38.0",
    "@navikt/ds-react": "7.38.0",
    "@tanstack/react-query": "5.100.14",
    "@tanstack/react-router": "1.170.10",
    "axios": "1.16.1",
    "date-fns": "4.4.0",
    "lodash": "4.18.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.77.0",
    "react-hot-toast": "2.6.0",
    "react-json-view-lite": "2.5.0",
    "react-select": "5.10.2",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "6.3.0",
    "@graphql-codegen/introspection": "5.0.2",
    "@graphql-codegen/typescript": "5.0.10",
    "@graphql-codegen/typescript-operations": "5.1.0",
    "@graphql-codegen/typescript-react-apollo": "4.4.1",
    "@graphql-codegen/typescript-resolvers": "5.1.8",
    "@navikt/aksel-stylelint": "7.38.0",
    "@tanstack/react-query-devtools": "5.100.14",
    "@tanstack/router-devtools": "1.167.0",
    "@tanstack/router-vite-plugin": "1.167.13",
    "@types/lodash": "4.17.24",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.60.0",
    "@typescript-eslint/parser": "8.60.0",
    "@vitejs/plugin-react": "5.1.2",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-lodash": "8.0.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unicorn": "62.0.0",
    "graphql": "16.14.0",
    "postcss-styled-syntax": "0.7.1",
    "prettier": "3.8.3",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "39.0.1",
    "swagger-typescript-api": "13.12.0",
    "typescript": "5.9.3",
    "vite": "^7.3.1",
    "vitest": "4.1.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.1"
  }
}
