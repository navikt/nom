{
  "name": "nom-ui",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev-debug": "vite --debug",
    "build": "tsc && vite build",
    "check-types": "tsc --noemit",
    "cy:open": "cypress open",
    "test": "vitest",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "stylelint": "stylelint '**/*.{tsx,css}'",
    "stylelint:fix": "stylelint --fix '**/*.{tsx,css}'",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx .",
    "generate-types": "swagger-typescript-api --path https://nom-api.intern.dev.nav.no/v3/api-docs/internal --output ./src/types --no-client -r -n api-models"
  },
  "dependencies": {
    "@apollo/client": "3.10.7",
