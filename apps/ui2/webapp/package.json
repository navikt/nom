    "@navikt/ds-react": "5.17.1",
    "@tanstack/react-query": "5.18.0",
    "@tanstack/react-router": "1.15.0",
    "axios": "1.6.7",
    "date-fns": "3.3.1",
    "lodash": "4.17.21",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "7.49.3",
