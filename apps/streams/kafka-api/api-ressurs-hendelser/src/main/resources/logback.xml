<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Use MDC-pattern always as it removes the pattern if the MDC does not contain a value for the mdc-key -->
            <pattern>%date{ISO8601} [%-5level] %logger{25} %replace(Nav-Consumer-Id=%mdc{Nav-Consumer-Id} ){'Nav-Consumer-Id= ',''}%replace(Nav-Call-Id=%mdc{Nav-Call-Id} ){'Nav-Call-Id= ',''}-- %message%n</pattern>
        </encoder>
    </appender>
    <!-- Ikke logg JDBC url med pwd i klartekst - spring boot 4 -->
    <logger name="org.hibernate.orm.connections.pooling" level="warn"/>
    <root level="info">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
