    <!-- Unleash logger -->
    <logger name="io.getunleash.event.UnleashSubscriber" level="DEBUG"/>

    <!-- Kafka loggers -->
    <logger name="org.apache.kafka" level="WARN"/>

    <!-- Spring Application availability logging -->
    <logger name="org.springframework.boot.availability.ApplicationAvailabilityBean" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="STDOUT_JSON"/>
        <appender-ref ref="SECURE_LOGS"/>
    </root>
