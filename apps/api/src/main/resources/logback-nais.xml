<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.core.filter.EvaluatorFilter">
            <evaluator class="ch.qos.logback.classic.boolex.OnMarkerEvaluator">
                <marker>SECURE_LOGS</marker>
            </evaluator>
            <OnMatch>DENY</OnMatch>
        </filter>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>trace_id</includeMdcKeyName>
            <includeMdcKeyName>span_id</includeMdcKeyName>
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <exclude>java\.util\.concurrent\..*</exclude>
                <exclude>org\.apache\.catalina\..*</exclude>
                <exclude>org\.apache\.coyote\..*</exclude>
                <exclude>org\.apache\.tomcat\..*</exclude>
                <exclude>org\.springframework\.aop\..*</exclude>
                <exclude>org\.springframework\.security\.web\.ObservationFilterChainDecorator</exclude>
            </throwableConverter>
        </encoder>
    </appender>

    <appender name="SECURE_LOGS" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>/secure-logs/secure.log</file>

        <!-- FixedWindowRollingPolicy is deprecared, ref: https://logback.qos.ch/manual/appenders.html#FixedWindowRollingPolicy -->
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>/secure-logs/secure.log.%i</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>1</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>50MB</maxFileSize>
            <!-- 5 sekunder i stedet for default 60s - Jeg tror vi med dagens logging kan klare opptil 5MB per sekund med logging under DVH last -->
            <checkIncrement>5000</checkIncrement>
        </triggeringPolicy>

        <!-- Denne bruker SizeAndTimeBasedFNATP i bakgrunnen som kun bruker default 60s checkInterval som ikke kan overstyres -->
        <!-- Prøver allikevel med FixedWindowRollingPolicy selv om den er deprecated -->
<!--        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">-->
<!--            &lt;!&ndash; rollover hourly &ndash;&gt;-->
<!--            <fileNamePattern>secure-%d{yyyy-MM-dd_HH}.%i.log.gz</fileNamePattern>-->
<!--            &lt;!&ndash; SecureLogs volume har 128MB limit : https://docs.nais.io/observability/logging/how-to/enable-secure-logs/?h=secure#set-log-rotation &ndash;&gt;-->
<!--            &lt;!&ndash; max size for current file 10MB, totalSizeCap for all archive files 90MB, 20MB buffer &ndash;&gt;-->
<!--            <maxFileSize>10MB</maxFileSize>-->
<!--            <maxHistory>1</maxHistory>-->
<!--            <totalSizeCap>90MB</totalSizeCap>-->
<!--            <checkIncrement>10 seconds</checkIncrement>-->
<!--        </rollingPolicy> -->

        <filter class="ch.qos.logback.core.filter.EvaluatorFilter">
            <!-- Deny log messages not having marker SECURE_LOGS -->
            <evaluator class="ch.qos.logback.classic.boolex.OnMarkerEvaluator">
                <marker>SECURE_LOGS</marker>
            </evaluator>
            <OnMatch>ACCEPT</OnMatch>
            <OnMismatch>DENY</OnMismatch>
        </filter>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Add MDC-keys always as it removes the pattern if the MDC does not contain a value for the key -->
            <includeMdcKeyName>trace_id</includeMdcKeyName>
            <includeMdcKeyName>span_id</includeMdcKeyName>
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <exclude>java\.util\.concurrent\..*</exclude>
                <exclude>org\.apache\.catalina\..*</exclude>
                <exclude>org\.apache\.coyote\..*</exclude>
                <exclude>org\.apache\.tomcat\..*</exclude>
                <exclude>org\.springframework\.aop\..*</exclude>
                <exclude>org\.springframework\.security\.web\.ObservationFilterChainDecorator</exclude>
            </throwableConverter>
        </encoder>
    </appender>

