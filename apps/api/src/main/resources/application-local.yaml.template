app:
  clients:
    dvh-ords:
      client_-id: DUMMY
      client-secret: DUMMY
      token-uri: DUMMY
      base-url: ${NOM_API_BASEURL}/api/admin/dvhOrds
      enhet-path: /enheter?numRows=0
      ressurs-stillinger-path: /statligeRessurserTilknytningerPaginated?offset=0&limit=100000
      eksterne-ressurser-path: /eksterneRessurserTilknytninger?numRows=0
      kommunale-ressurser-path: /kommunaleRessurser?numRows=0
      ansatte-buckets-path: /ressurser?numRows=0
      tlf-path: /telefoner?numRows=0
      org-hierarki-path: /organiseringOgLedere?numRows=0
    microsoft-graph:
      groups:
        nom-delegert: "42d11885-1e29-4fc4-9eed-1b339c2c8e36"
        nom-leder: "e9cd9267-9baf-4078-abb8-7251c4313d32"     
  granted-authorities:
    clients:
      nom-ui2:
        client-id: "af2f9386-07cf-4fb9-8612-c4724335a43c"
        scopes: ["QUERY_PERSON", "MUTATE_RESSURS"]
      ida:
        client-id: "744e4092-4215-4e02-87df-a61aaf1b95b5"
        scopes: ["QUERY_PERSON", "MUTATE_RESSURS"]
      dolly:
        client-id: "b54ec20c-ab8a-4e3f-bc34-aa452ddf0f3b"
