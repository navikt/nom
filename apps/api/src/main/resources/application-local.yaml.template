# -- statiske verdier for lokalkjøring:
NAIS_APP_NAME: 'nom-api'

NOM_PROXY_BASEURL: https://nom-proxy.dev-fss-pub.nais.io
NOM_PROXY_CLIENT_ID: dev-fss.nom.nom-proxy

PDL_BASEURL: https://pdl-api.dev-fss-pub.nais.io
PDL_CLIENT_ID: dev-fss.pdl.pdl-api


# --  DB. Konfigurer med cloud-proxy mot miljø, eller mot lokal postgres container via docker-compose
