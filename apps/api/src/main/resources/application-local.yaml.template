AZURE_APP_WELL_KNOWN_URL: 'placeholder'
AZURE_APP_CERTIFICATE_KEY_ID: 'placeholder'
AZURE_APP_TENANT_ID: 'placeholder'
AZURE_APP_CLIENT_SECRET: 'placeholder'
