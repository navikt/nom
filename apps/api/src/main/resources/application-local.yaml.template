DATABASE_PORT: 5432
DATABASE_DATABASE: postgres-api
DATABASE_USERNAME: postgres
DATABASE_PASSWORD: password


# -- for å inspisere nettverkskall når man kjører profile proxy
proxy:
  host: 127.0.0.1
  port: 8866
