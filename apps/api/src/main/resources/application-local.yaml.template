      fullmaktsregister-web:
        client-id: "6f1992f0-f425-4512-b1f6-97a7e840414c"
        scopes: ["QUERY_PERSON"]
    groups:
      nom-write:
        group-id: "${NOM_WRITE_GROUPID}"
        scopes: [ "MUTATE_RESSURS" ]
      nom-admin:
        group-id: "${NOM_ADMIN_GROUPID}"
        scopes: ["ADMIN"]
  manuelle-ressurser-og-ledere:
    enabled: false
  google-storage-bucket-name:
    missing-ot: "DUMMY"

# DB. Bruk cloud-proxy mot miljø, eller kjør postgres lokalt

DATABASE_HOST: localhost
DATABASE_PORT: 5438
DATABASE_DATABASE: postgres-api
DATABASE_USERNAME: postgres
DATABASE_PASSWORD: password
DATABASE_JDBC_URL: jdbc:postgresql://${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_DATABASE}?password=${DATABASE_PASSWORD}&user=${DATABASE_USERNAME}

HOSTNAME: "localhost"

ELECTOR_PATH: Dummy

proxy:
  host: 127.0.0.1
  port: 8866

server.port: 8081

KAFKA_BROKERS: "localhost:39092"

spring:
  kafka:
    security.protocol: PLAINTEXT
  security:
    oauth2:
      client:
        registration:
          nom-api:
            provider: azure
            client-id: ${AZURE_APP_CLIENT_ID}
            client-secret: ${AZURE_APP_CLIENT_SECRET}
            authorization-grant-type: client_credentials
            scope:
              - ${NOM_API_API_SCOPE}

logging:
  level:
    no.nav.nom: DEBUG

management:
  endpoints:
    web:
      exposure:
        include: prometheus,health,mappings,flyway,info,loggers,metrics