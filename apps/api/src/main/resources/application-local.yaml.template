# Oppdater disse med nyeste verdier fra dev-miljø for å kjøre lokalt

  #!/bin/sh
  CTX=dev-gcp
  NS=nom
  SECRET_NAME=`kubectl get secrets --sort-by='{metadata.creationTimestamp}' --context=${CTX} --namespace=${NS}|grep ^azure-nom-api|grep -v token|tail -1|cut -d ' ' -f1`
  SECRET=`kubectl get secret $SECRET_NAME -o json --context=${CTX} --namespace=${NS}`
  CLIENT_ID=`echo $SECRET |jq '.data.AZURE_APP_CLIENT_ID' -r|base64 -d`
  TENANT_ID=`echo $SECRET |jq '.data.AZURE_APP_TENANT_ID' -r|base64 -d`
  JWK=`echo $SECRET |jq '.data.AZURE_APP_JWK' -r|base64 -d`
  echo
  echo 'AZURE_APP_TENANT_ID: '$TENANT_ID
  echo 'AZURE_APP_CLIENT_ID: '$CLIENT_ID
  echo 'AZURE_APP_JWK: '\'$JWK\'

AZURE_APP_CLIENT_ID: 'placeholder'
AZURE_APP_TENANT_ID: 'placeholder'
AZURE_APP_JWK: 'placeholder'

# ---


NAIS_APP_NAME: 'nom-api'

NOM_PROXY_BASEURL: https://nom-proxy.dev-fss-pub.nais.io
NOM_PROXY_CLIENT_ID: dev-fss.nom.nom-proxy

PDL_BASEURL: https://pdl-api.dev-fss-pub.nais.io
PDL_CLIENT_ID: dev-fss.pdl.pdl-api


# DB. Bruk cloud-proxy mot miljø, eller kjør postgres lokalt

DATABASE_HOST: localhost
DATABASE_PORT: 5432
DATABASE_DATABASE: postgres-api
DATABASE_USERNAME: postgres
DATABASE_PASSWORD: password

HOSTNAME: "localhost"

proxy:
  host: 127.0.0.1
  port: 8866

server.port: 8081