<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Use MDC-pattern always as it removes the pattern if the MDC does not contain a value for the mdc-key -->
            <pattern>%date{ISO8601} [%-5level] %logger{25} %replace(Nav-Consumer-Id=%mdc{Nav-Consumer-Id} ){'Nav-Consumer-Id= ',''}%replace(Nav-Call-Id=%mdc{Nav-Call-Id} ){'Nav-Call-Id= ',''}-- %message%n</pattern>
        </encoder>
    </appender>

<!-- NOM loggers -->
<!--    <logger name="no.nav.nom" level="debug" />-->
    <logger name="no.nav.nom.apps.api.rest.sessioninfo" level="debug" />
<!--    <logger name="no.nav.nom.apps.api.common.security" level="trace"/>-->
<!--    <logger name="no.nav.nom.apps.api.graphql.common.SecurityUtil" level="trace"/>-->

<!-- Spring Security logger -->
<!--    <logger name="org.springframework.security" level="trace"/>-->

<!-- GraphQL loggers -->
<!--    <logger name="graphql" level="trace"/>-->
<!--    <logger name="org.dataloader" level="trace"/>-->
<!--    <logger name="org.springframework.graphql" level="trace"/>-->
<!--    <logger name="org.springframework.boot.autoconfigure.graphql" level="trace"/>-->

    <!-- Kafka loggers -->
    <logger name="org.apache.kafka" level="WARN"/>

    <root level="info">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
