type Mutation {

    opprettRessurs(personIdent: String!, forbokstav: String): OpprettRessursResponse

    opprettRessurs2(request: OpprettRessursRequest2): OpprettRessursResponse2

    opprettRessurs0(request: OpprettRessursRequest0): OpprettRessursResponse0

    # OrdreLinje
    ordreRessurs(request: OpprettRessursRequest!): OrdreLinjeResponse!
    opprettEnhet(request: OpprettEnhetRequest!): OrdreLinjeResponse!

    # Ordre

    #    removeRequestFromOrdre(ordreId: ID!, ordreLinjeId: ID!): ResultCode!
    #    editOrdre(ordreId: ID!, metadata: EditOrdreRequest!): ResultCode!
    godkjennOrdre(ordreId: ID!): ResultCode!
}

# Requests

input OpprettRessursRequest0 {
    personident: String!
    visningsfornavn: String!
    visningsetternavn: String!
    sektor: Sektor!
    orgEnhet: String
    startDato: Date
}

input OrdreLinjeRequestMetadata {
    # Request set/Endringspakke, valgfri, bruk for å legge til eksisterende pakke
    ordreId: ID
    beskrivelse: String
}

input OpprettRessursRequest  {
    personIdent: String    @deprecated(reason: "personIdent er erstattet med personident")
    personident: String
    visningsnavn: String
}

input OpprettRessursRequest2 {
    personident: String!
    fornavn: String!
    etternavn: String!
}

input OpprettEnhetRequest {
    metadata: OrdreLinjeRequestMetadata!
    agressoId: String
    navn: String!
}

input EditOrdreRequest {
    beskrivelse: String
}

# Responses

type OpprettRessursResponse0 {
    personident: String!
    navident: String!
    visningsfornavn: String!
    visningsetternavn: String!
    sektor: Sektor!
}

type OrdreLinjeResponse  {
    ordreLinje: OrdreLinje!
}

type OpprettRessursResponse {
    navIdent: String!   @deprecated(reason: "navIdent er erstattet med navident")
    navident: String!
    personIdent: String!    @deprecated(reason: "personIdent er erstattet med personident")
    personident: String!
    person: FolkeregisterPerson
    folkeregisterPerson: FolkeregisterPerson
}

type OpprettRessursResponse2 {
    navident: String!
    personident: String!
    person: FolkeregisterPerson
    folkeregisterPerson: FolkeregisterPerson
    fornavn: String!
    etternavn: String!
}

enum OrdreLinjesaktiving {
    IMMEDIATE
    FOR_APPROVAL
}

enum OrdreLinjeType {
    OPPRETT_ENHET,
    OPPRETT_RESSURS
}

type OrdreLinjeMetadata {
    ordreId: ID!
    beskrivelse: String
}
