type Mutation {

    # Bestilling
    opprettRessurs(request: OpprettRessursRequest!): RessursBestillingResponse!
    opprettEnhet(request: OpprettEnhetRequest!): EnhetBestillingResponse!

    # RequestSets

    #    removeRequestFromRequestSet(requestSetId: ID!, requestId: ID!): ResultCode!
    #    editRequestSet(requestSetId: ID!, metadata: EditRequestSetRequest!): ResultCode!
    activateRequestSet(requestSetId: ID!, when: DateTime): ResultCode!
}

# Requests

input BestillingRequestMetadata {
    # Request set/Endringspakke, valgfri, bruk for å legge til eksisterende pakke
    requestSetId: ID
    aktivering: Bestillingsaktiving = IMMEDIATE
    beskrivelse: String
}

input OpprettRessursRequest  {
    metadata: BestillingRequestMetadata!
    personIdent: String!
    visningsnavn: String
}

input OpprettEnhetRequest {
    metadata: BestillingRequestMetadata!
    agressoId: String
    navn: String!
}

input EditRequestSetRequest {
    beskrivelse: String
}

# Responses

type EnhetBestillingResponse  {
    nomId: ID
    bestilling: Bestilling!
}

type RessursBestillingResponse {
    nomId: ID
    navIdent: ID
    bestilling: Bestilling!
}

enum Bestillingsaktiving {
    IMMEDIATE
    FOR_APPROVAL
}

type Bestilling {
    requestId: ID!
    requestSetId: ID!
    metadata: BestillingMetadata
    type: BestillingType
    # define explicitly?
    data: JSON
}

enum BestillingType {
    OPPRETT_ENHET,
    OPPRETT_RESSURS
}

type BestillingMetadata {
    requestSetId: ID!
    aktivering: Bestillingsaktiving!
    beskrivelse: String
}
