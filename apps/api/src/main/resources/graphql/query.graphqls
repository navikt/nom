scalar Date
scalar DateTime

type Query {
    organisasjonsenhet(where: OrganisasjonsenhetSearch): [Organisasjonsenhet!]!
    ressurs(where: RessursSearch): [Ressurs!]!
}

input OrganisasjonsenhetSearch {
    agressoId: String
}

input RessursSearch {
    navIdent: String
    personIdent: String
}

type Organisasjonsenhet {
    agressoId: ID!
    navn: String!
    gyldigFom: Date!
    gyldigTom: Date
    organiseringer : [Organisering!]!
    leder: [OrganisasjonsenhetsLeder!]!
    koblinger: [OrganisasjonsenhetsKobling!]!
}

type Organisering {
    retning: String!
    organisasjonsenhet : Organisasjonsenhet!
    gyldigFom: Date!
    gyldigTom: Date
}

type Ressurs {
    navIdent: String!
    personIdent: String!
    koblinger: [RessursKobling!]!
}

type OrganisasjonsenhetsLeder{
    ressurs: Ressurs!
}

type OrganisasjonsenhetsKobling {
    ressurs: Ressurs!
    gyldigFom: Date!
    gyldigTom: Date
}

type RessursKobling {
    organisasjonsenhet: Organisasjonsenhet!
    gyldigFom: Date!
    gyldigTom: Date
}

enum Retning {
    over,
    under,
}