AZURE_APP_TENANT_ID: 'placeholder'
AZURE_APP_CLIENT_ID: 'placeholder'
AZURE_APP_JWK: 'placeholder'
AZURE_APP_CLIENT_SECRET: 'placeholder'

NAIS_APP_NAME: 'nav-ident'
HOSTNAME: "localhost"

PDL_BASEURL: https://pdl-api.dev-fss-pub.nais.io
PDL_CLIENT_ID: dev-fss.pdl.pdl-api
PDL_API_SCOPE: api://dev-fss.pdl.pdl-api/.default

# Embedded kafka
KAFKA_BROKERS: localhost:39092
spring.kafka.properties.security.protocol: PLAINTEXT

# DB. Bruk cloud-proxy mot miljø, eller kjør postgres lokalt
DATABASE_HOST: localhost
DATABASE_PORT: 5434
DATABASE_DATABASE: postgres-navident
DATABASE_USERNAME: postgres
DATABASE_PASSWORD: password
DATABASE_JDBC_URL: jdbc:postgresql://${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_DATABASE}

#Embedded redis
REDIS_HOST: "localhost"

server.port: 8088

app:
  gs-bucket-name: no-nav-org-dev-nav-ident-storage-bucket

spring:
  datasource:
    username: ${DATABASE_USERNAME}
    password: ${DATABASE_PASSWORD}
