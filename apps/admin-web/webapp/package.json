{
  "name": "nom-admin-web",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev:debug": "vite --debug",
    "build": "tsc && vite build",
    "check-types": "tsc --noemit",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx .",
    "stylelint": "stylelint '**/*.{tsx,css}'",
    "stylelint:fix": "stylelint --fix '**/*.{tsx,css}'",
    "fixes": "npm run lint:fix && npm run stylelint:fix",
    "generate-types:nom-admin": "swagger-typescript-api generate --path https://nom-admin-api.intern.dev.nav.no/v3/api-docs/internal --output ./src/types/nom-admin --no-client -r -n nom-admin-models",
    "generate-types:nom-api": "swagger-typescript-api generate --path https://nom-api.intern.dev.nav.no/v3/api-docs/internal --output ./src/types/nom-api --no-client -r -n nom-api-models",
    "generate-types:nom-api-admin": "swagger-typescript-api generate --path https://nom-api.intern.dev.nav.no/v3/api-docs/internal_admin --output ./src/types/nom-api --no-client -r -n nom-api-admin-models",
    "generate-types:nom-remedy-integrasjon": "swagger-typescript-api generate --path https://nom-remedy-integrasjon.intern.dev.nav.no/v3/api-docs --output ./src/types/nom-remedy-integrasjon --no-client -r -n nom-remedy-integrasjon-models",
    "generate-types": "npm run generate-types:nom-admin && npm run generate-types:nom-api && npm run generate-types:nom-api-admin && npm run generate-types:nom-remedy-integrasjon",
    "all-checks": "npm run check-types && npm run lint && npm run stylelint"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@hookform/resolvers": "5.9.1",
    "@navikt/aksel-icons": "7.37.0",
    "@navikt/ds-css": "7.37.0",
    "@navikt/ds-react": "7.37.0",
    "@navikt/ds-tailwind": "7.37.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.29",
    "date-fns": "4.4.0",
    "ky": "1.14.2",
    "lodash": "4.18.1",
    "query-string": "9.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "6.1.3",
    "react-hook-form": "7.85.0",
    "react-hot-toast": "^2.6.0",
    "react-json-view-lite": "2.5.0",
    "swagger-typescript-api": "^13.12.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@navikt/aksel-stylelint": "7.37.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/router-vite-plugin": "1.167.32",
    "@types/lodash": "4.17.25",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitejs/plugin-react": "5.1.2",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-lodash": "8.0.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unicorn": "62.0.0",
    "postcss-import": "16.1.1",
    "postcss-styled-syntax": "0.7.1",
    "prettier": "3.9.6",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "39.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.4"
  }
}
