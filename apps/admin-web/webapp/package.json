{
  "name": "nom-admin-web",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev:debug": "vite --debug",
    "build": "tsc && vite build",
    "check-types": "tsc --noemit",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx .",
    "stylelint": "stylelint '**/*.{tsx,css}'",
    "stylelint:fix": "stylelint --fix '**/*.{tsx,css}'",
    "generate-types:nom-admin": "swagger-typescript-api --path https://nom-admin-api.intern.dev.nav.no/v3/api-docs/internal --output ./src/types/nom-admin --no-client -r -n nom-admin-models",
    "generate-types:nom-api": "swagger-typescript-api --path https://nom-api.intern.dev.nav.no/v3/api-docs/internal --output ./src/types/nom-api --no-client -r -n nom-api-models",
    "generate-types:nom-api-admin": "swagger-typescript-api --path https://nom-api.intern.dev.nav.no/v3/api-docs/internal_admin --output ./src/types/nom-api --no-client -r -n nom-api-admin-models",
    "generate-types": "npm run generate-types:nom-admin && npm run generate-types:nom-api && npm run generate-types:nom-api-admin",
    "all-checks": "npm run check-types && npm run lint"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@hookform/resolvers": "3.6.0",
    "@navikt/aksel-icons": "6.10.1",
    "@navikt/ds-css": "6.10.1",
    "@navikt/ds-react": "6.10.1",
    "@navikt/ds-tailwind": "6.10.1",
    "@tanstack/react-query": "5.45.1",
    "@tanstack/react-router": "1.38.1",
    "date-fns": "3.6.0",
    "ky": "1.3.0",
    "lodash": "4.17.21",
    "query-string": "9.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-error-boundary": "4.0.13",
    "react-hook-form": "7.52.0",
    "react-hot-toast": "^2.4.1",
    "react-json-view-lite": "1.4.0",
    "swagger-typescript-api": "^13.0.12",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@navikt/aksel-stylelint": "6.10.1",
    "@tanstack/eslint-plugin-query": "5.43.1",
    "@tanstack/react-query-devtools": "5.45.1",
    "@tanstack/router-devtools": "1.38.1",
    "@tanstack/router-vite-plugin": "1.38.0",
    "@types/lodash": "4.17.5",
    "@types/node": "^22.5.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "7.13.0",
    "@typescript-eslint/parser": "7.13.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-lodash": "7.4.0",
    "eslint-plugin-prettier": "5.1.3",
    "eslint-plugin-react": "7.34.2",
    "eslint-plugin-simple-import-sort": "12.1.0",
    "eslint-plugin-unicorn": "54.0.0",
    "postcss-import": "16.1.0",
    "postcss-styled-syntax": "0.6.4",
    "prettier": "3.3.2",
    "stylelint": "16.6.1",
    "stylelint-config-standard": "36.0.0",
    "tailwindcss": "3.4.4",
    "typescript": "5.4.5",
    "vite": "5.4.7"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.21.1"
  }
}
