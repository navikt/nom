{
  "name": "nom-admin-web",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev:debug": "vite --debug",
    "build": "tsc && vite build",
    "check-types": "tsc --noemit",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx .",
    "stylelint": "stylelint '**/*.{tsx,css}'",
    "stylelint:fix": "stylelint --fix '**/*.{tsx,css}'",
    "fixes": "npm run lint:fix && npm run stylelint:fix",
    "generate-types:nom-admin": "swagger-typescript-api generate --path https://nom-admin-api.intern.dev.nav.no/v3/api-docs/internal --output ./src/types/nom-admin --no-client -r -n nom-admin-models",
    "generate-types:nom-api": "swagger-typescript-api generate --path https://nom-api.intern.dev.nav.no/v3/api-docs/internal --output ./src/types/nom-api --no-client -r -n nom-api-models",
    "generate-types:nom-api-admin": "swagger-typescript-api generate --path https://nom-api.intern.dev.nav.no/v3/api-docs/internal_admin --output ./src/types/nom-api --no-client -r -n nom-api-admin-models",
    "generate-types:nom-remedy-integrasjon": "swagger-typescript-api generate --path https://nom-remedy-integrasjon.intern.dev.nav.no/v3/api-docs --output ./src/types/nom-remedy-integrasjon --no-client -r -n nom-remedy-integrasjon-models",
    "generate-types:nom-sf-integrasjon": "swagger-typescript-api generate --path https://nom-sf-integrasjon.intern.dev.nav.no/v3/api-docs/Internal%20admin --output ./src/types/nom-sf-integrasjon --no-client -r -n nom-sf-integrasjon-models",
    "generate-types": "npm run generate-types:nom-admin && npm run generate-types:nom-api && npm run generate-types:nom-api-admin && npm run generate-types:nom-remedy-integrasjon && npm run generate-types:nom-sf-integrasjon",
    "all-checks": "npm run check-types && npm run lint && npm run stylelint"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@hookform/resolvers": "5.9.1",
    "@navikt/aksel-icons": "7.37.0",
    "@navikt/ds-css": "7.37.0",
    "@navikt/ds-react": "7.37.0",
    "@navikt/ds-tailwind": "7.37.0",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-router": "1.170.46",
    "date-fns": "4.4.0",
    "ky": "2.2.0",
    "lodash": "4.18.1",
    "query-string": "9.5.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "react-hook-form": "7.91.0",
    "react-hot-toast": "^2.6.1",
    "react-json-view-lite": "2.5.0",
    "swagger-typescript-api": "^13.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@navikt/aksel-stylelint": "7.37.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "5.106.1",
    "@tanstack/react-query-devtools": "5.106.1",
    "@tanstack/router-vite-plugin": "1.167.48",
    "@types/lodash": "4.17.27",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "6.2.1",
    "autoprefixer": "10.6.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-lodash": "8.1.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-jsx": "5.28.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unicorn": "74.0.0",
    "postcss-import": "17.0.1",
    "postcss-styled-syntax": "0.7.2",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.67.4"
  }
}
