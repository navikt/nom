{
  "name": "nom-admin-web",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev:debug": "vite --debug",
    "build": "tsc && vite build",
    "check-types": "tsc --noemit",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx .",
    "stylelint": "stylelint '**/*.{tsx,css}'",
    "stylelint:fix": "stylelint --fix '**/*.{tsx,css}'",
    "generate-types:nom-admin": "swagger-typescript-api --path https://nom-admin-api.intern.dev.nav.no/v3/api-docs/internal --output ./src/types/nom-admin --no-client -r -n nom-admin-models",
    "generate-types:nom-api": "swagger-typescript-api --path https://nom-api.intern.dev.nav.no/v3/api-docs/internal --output ./src/types/nom-api --no-client -r -n nom-api-models",
    "generate-types:nom-api-admin": "swagger-typescript-api --path https://nom-api.intern.dev.nav.no/v3/api-docs/internal_admin --output ./src/types/nom-api --no-client -r -n nom-api-admin-models",
    "generate-types": "npm run generate-types:nom-admin && npm run generate-types:nom-api && npm run generate-types:nom-api-admin",
    "all-checks": "npm run check-types && npm run lint && npm run stylelint"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@hookform/resolvers": "5.0.1",
    "@navikt/aksel-icons": "7.20.0",
    "@navikt/ds-css": "7.20.0",
    "@navikt/ds-react": "7.20.0",
    "@navikt/ds-tailwind": "7.20.0",
    "@tanstack/react-query": "5.74.4",
    "@tanstack/react-router": "1.117.0",
    "date-fns": "4.1.0",
    "ky": "1.8.1",
    "lodash": "4.17.21",
    "query-string": "9.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-error-boundary": "5.0.0",
    "react-hook-form": "7.56.1",
    "react-hot-toast": "^2.5.2",
    "react-json-view-lite": "2.4.1",
    "swagger-typescript-api": "^13.1.1",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@navikt/aksel-stylelint": "7.20.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@tanstack/eslint-plugin-query": "5.73.3",
    "@tanstack/react-query-devtools": "5.74.6",
    "@tanstack/router-devtools": "1.117.0",
    "@tanstack/router-vite-plugin": "1.117.0",
    "@types/lodash": "4.17.16",
    "@types/node": "^22.14.1",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@typescript-eslint/eslint-plugin": "8.31.0",
    "@typescript-eslint/parser": "8.31.0",
    "@vitejs/plugin-react": "4.4.1",
    "autoprefixer": "10.4.21",
    "eslint": "9.25.1",
    "eslint-config-prettier": "10.1.2",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-lodash": "8.0.0",
    "eslint-plugin-prettier": "5.2.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unicorn": "58.0.0",
    "postcss-import": "16.1.0",
    "postcss-styled-syntax": "0.7.1",
    "prettier": "3.5.3",
    "stylelint": "16.18.0",
    "stylelint-config-standard": "38.0.0",
    "tailwindcss": "4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.40.0"
  }
}
