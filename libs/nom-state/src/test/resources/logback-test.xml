<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- console appender for test og lokalkjøring - uten MDC -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%date{ISO8601} [%-5level] %logger{25} -- %message%n</pattern>
        </encoder>
    </appender>

<!--    <logger name="no.nav.nom" level="debug" />-->

    <!-- Quiet down kafka logging -->
    <logger name="org.apache.kafka" level="warn" />
    <logger name="org.apache.zookeeper" level="warn" />
    <logger name="kafka" level="warn" />
    <logger name="state.change.logger" level="error" />

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
