<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.1.5</version> <!-- Ved oppdatering av Spring - sjekk changelog for nye versjoner, og om man da kan ta bort overstyrte versjoner under -->
        <relativePath/>
    </parent>

    <groupId>no.nav.nom</groupId>
    <artifactId>nom</artifactId>
    <version>1.1.0</version>
    <packaging>pom</packaging>
    <name>NOM</name>

    <modules>
        <module>libs</module>
        <module>apps</module>
        <module>docs</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.source>${java.version}</maven.compiler.source>

        <spring-boot.version>3.1.5</spring-boot.version>

        <logstash-logback-encoder.version>7.4</logstash-logback-encoder.version>
        <gcp.libraries-bom.version>26.27.0</gcp.libraries-bom.version>
        <springdoc.version>2.2.0</springdoc.version>
        <springdoc-openapi-security.version>1.7.0</springdoc-openapi-security.version>
        <hypersistence-utils-hibernate-62.version>3.6.1</hypersistence-utils-hibernate-62.version>
        <graphql-extended-scalars.version>21.0</graphql-extended-scalars.version>
        <unleash.version>9.0.0</unleash.version>
        <opencsv.version>5.8</opencsv.version>
        <apache.common.csv.version>1.10.0</apache.common.csv.version>
        <commons-fileupload.version>1.5</commons-fileupload.version>
        <ulid-creator.version>5.2.2</ulid-creator.version>
        <vault-jdbc.version>1.3.10</vault-jdbc.version>
        <swagger-annotations-jakarta.version>2.2.19</swagger-annotations-jakarta.version>
        <wiremock.version>2.35.1</wiremock.version>
        <org.wiremock.version>3.3.1</org.wiremock.version>
        <wiremock-extension.version>1.0.2.RELEASE</wiremock-extension.version>
        <spring-cloud-contract-wiremock.version>4.0.4</spring-cloud-contract-wiremock.version>
        <mock-oauth2-server.version>2.0.0</mock-oauth2-server.version>
        <nimbus-jose-jwt.version>9.37.1</nimbus-jose-jwt.version>
        <hibernate-validator.version>8.0.1.Final</hibernate-validator.version>
        <ojdbc.version>23.3.0.23.09</ojdbc.version>

        <!-- Override spring-boot-dependencies version -->
        <snakeyaml.version>2.2</snakeyaml.version>  <!-- https://github.com/navikt/nom/security/dependabot/85 versjon 1.33 er vuln.  -->
            <!-- note - local precedence import in utils-common, api, proxy, nom-ressurser, Unit4, nav-ident, og streams appene -->
        <netty.version>4.1.101.Final</netty.version> <!-- https://github.com/navikt/nom/security/dependabot/90 + https://github.com/navikt/nom/security/dependabot/89 -->
        <zookeeper.version>3.9.1</zookeeper.version> <!-- https://github.com/navikt/nom/security/dependabot/91 -->

        <!-- Override av andre transient dependencies -->
        <orgjson.version>20231013</orgjson.version>  <!-- https://github.com/navikt/nom/security/dependabot/92 -->
        <snappy-java.test.version>1.1.10.5</snappy-java.test.version>
        <commons-compress.version>1.24.0</commons-compress.version> <!-- https://github.com/navikt/nom/security/dependabot/88 -->
        <httpclient.version>4.5.14</httpclient.version> <!-- https://github.com/navikt/nom/security/dependabot/94 -->
        <bcpkix-jdk18on.version>1.76</bcpkix-jdk18on.version> <!-- https://github.com/navikt/nom/security/dependabot/95 -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.json</groupId>
                <artifactId>json</artifactId>
                <version>${orgjson.version}</version> <!-- https://github.com/navikt/nom/security/dependabot/92 -->
            </dependency>

            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>${snappy-java.test.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.osgi</groupId>
                        <artifactId>org.osgi.core</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!-- Ordinære dependencies ikke definert i Spring starter -->
            <dependency>
                <groupId>com.google.cloud</groupId>
                <artifactId>libraries-bom</artifactId>
                <version>${gcp.libraries-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>no.nav.nom</groupId>
                <artifactId>contract-nom-dto</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>no.nav.nom</groupId>
                <artifactId>utils-common</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>no.nav.nom</groupId>
                <artifactId>lucene-wrapper-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>no.nav.nom</groupId>
                <artifactId>lucene-wrapper-nomdomain</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
                <exclusions> <!-- https://github.com/navikt/nom/security/dependabot/85 -->
                    <exclusion>
                        <groupId>org.yaml</groupId>
                        <artifactId>snakeyaml</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-security</artifactId>
                <version>${springdoc-openapi-security.version}</version>
                <exclusions> <!-- https://github.com/navikt/nom/security/dependabot/85 -->
                    <exclusion>
                        <groupId>org.yaml</groupId>
                        <artifactId>snakeyaml</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>

            <dependency>
                <!-- previously named com.vladmihalcea:hibernate-types-55 -->
                <!-- now https://github.com/vladmihalcea/hypersistence-utils -->
                <groupId>io.hypersistence</groupId>
                <artifactId>hypersistence-utils-hibernate-62</artifactId>
                <version>${hypersistence-utils-hibernate-62.version}</version>
            </dependency>

            <dependency>
                <groupId>com.graphql-java</groupId>
                <artifactId>graphql-java-extended-scalars</artifactId>
                <version>${graphql-extended-scalars.version}</version>
            </dependency>

            <dependency>
                <groupId>io.getunleash</groupId>
                <artifactId>unleash-client-java</artifactId>
                <version>${unleash.version}</version>
            </dependency>

            <dependency>
                <groupId>com.opencsv</groupId>
                <artifactId>opencsv</artifactId>
                <version>${opencsv.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-csv</artifactId>
                <version>${apache.common.csv.version}</version>
            </dependency>

            <dependency>
                <groupId>commons-fileupload</groupId>
                <artifactId>commons-fileupload</artifactId>
                <version>${commons-fileupload.version}</version>
            </dependency>

            <dependency>
                <groupId>com.github.f4b6a3</groupId>
                <artifactId>ulid-creator</artifactId>
                <version>${ulid-creator.version}</version>
            </dependency>

            <dependency>
                <groupId>no.nav</groupId>
                <artifactId>vault-jdbc</artifactId>
                <version>${vault-jdbc.version}</version>
            </dependency>

            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>${nimbus-jose-jwt.version}</version>
            </dependency>

            <!-- For å koble på Oracle datakilder  -->
            <dependency>
                <groupId>org.hibernate</groupId>
                <artifactId>hibernate-validator</artifactId>
                <version>${hibernate-validator.version}</version>
            </dependency>
            <dependency>
                <groupId>com.oracle.database.jdbc</groupId>
                <artifactId>ojdbc11</artifactId>
                <version>${ojdbc.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- Test dependencies -->
            <dependency>
                <groupId>no.nav.nom</groupId>
                <artifactId>utils-test</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-test</artifactId>
                <version>${spring-boot.version}</version>
                <exclusions>
                    <exclusion> <!-- org.json:json conflict -->
                        <groupId>com.vaadin.external.google</groupId>
                        <artifactId>android-json</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>org.yaml</groupId>
                        <artifactId>snakeyaml</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <dependency>
                <groupId>com.thomaskasene.wiremock</groupId>
                <artifactId>wiremock-junit-extension</artifactId>
                <version>${wiremock-extension.version}</version>
            </dependency>

            <dependency>
                <groupId>com.github.tomakehurst</groupId>
                <artifactId>wiremock-jre8-standalone</artifactId>
                <version>${wiremock.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>commons-fileupload</groupId>
                        <artifactId>commons-fileupload</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${org.wiremock.version}</version>
            </dependency>

            <dependency>
                <groupId>no.nav.security</groupId>
                <artifactId>mock-oauth2-server</artifactId>
                <version>${mock-oauth2-server.version}</version>
                <exclusions>
                    <exclusion>     <!-- Override denne - har transitiv vuln - https://github.com/navikt/nom/security/dependabot/95 -->
                        <groupId>org.bouncycastle</groupId>
                        <artifactId>bcpkix-jdk15on</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <dependency> <!-- Bruk denne for mock-oauth2-server - har transitiv vuln - https://github.com/navikt/nom/security/dependabot/95 -->
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bcpkix-jdk18on.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-contract-wiremock</artifactId>
                <version>${spring-cloud-contract-wiremock.version}</version>
            </dependency>

            <!-- fra org.springframework.kafka:spring-kafka-test-->
            <dependency>
                <groupId>org.apache.zookeeper</groupId>
                <artifactId>zookeeper</artifactId>
                <version>${zookeeper.version}</version>  <!-- https://github.com/navikt/nom/security/dependabot/91 -->
            </dependency>

            <!-- fra org.testcontainers:testcontainers:jar:1.18.3:test -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>${commons-compress.version}</version>  <!-- https://github.com/navikt/nom/security/dependabot/88 -->
            </dependency>

            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient</artifactId>
                <version>${httpclient.version}</version>    <!-- https://github.com/navikt/nom/security/dependabot/94 -->
            </dependency>

            <dependency> <!-- Påkrevd for mac M1  -->
                <groupId>io.netty</groupId>
                <artifactId>netty-resolver-dns-native-macos</artifactId>
                <classifier>osx-x86_64</classifier>
                <version>${netty.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <dependencyConvergence/>
                                <ReactorModuleConvergence/>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                            <fail>false</fail> <!-- Disable fails due to breaking up modules -->
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/IT*</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>