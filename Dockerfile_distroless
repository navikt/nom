# Spesifiser image SHA for alltid å kunne få dependabot til å si ifra om ny versjon. (For apper som ikke deployes ofte)
FROM gcr.io/distroless/java21-debian12@sha256:fe0560fbf87031402f6c725917eabbf9217b5e9fc95fdff9a004dba3587a0513
ARG JAR_PATH
ARG JAVA_OPTS

ENV LC_ALL='nb_NO.UTF-8' LANG='nb_NO.UTF-8' TZ='Europe/Oslo'
ENV JDK_JAVA_OPTIONS ${JAVA_OPTS}

USER nonroot
WORKDIR /app

COPY ${JAR_PATH} app.jar

CMD ["app.jar"]